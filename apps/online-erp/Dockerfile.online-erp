FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /workspace

FROM base AS deps
WORKDIR /workspace
COPY apps/online-erp/package.json ./package.json
COPY apps/online-erp/package-lock.json ./package-lock.json
COPY apps/online-erp/prisma ./prisma/
COPY packages ./packages/
COPY apps/online-erp/prisma.config.ts ./prisma.config.ts
RUN npm ci

FROM base AS builder
WORKDIR /workspace
COPY --from=deps /workspace/node_modules ./node_modules
COPY . .
WORKDIR /workspace/apps/online-erp
ARG ONLINE_ERP_API_URL
ENV ONLINE_ERP_API_URL=${ONLINE_ERP_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN test -n "$ONLINE_ERP_API_URL"
RUN npx prisma generate
RUN npx next build

FROM base AS runner
WORKDIR /workspace/apps/online-erp
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder /workspace/apps/online-erp/public ./public
COPY --from=builder /workspace/apps/online-erp/.next/standalone ./
COPY --from=builder /workspace/apps/online-erp/.next/static ./.next/static
EXPOSE 3000
CMD ["node", "server.js"]
