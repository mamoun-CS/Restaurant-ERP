{
  "name": "restaurant-desktop-pos",
  "version": "0.1.0",
  "description": "Offline-first Windows restaurant point of sale",
  "author": "Sheikh Al Kar",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -p tsconfig.electron.json && tsc -b && vite build",
    "package:windows": "npm run build && electron-builder --win nsis",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@restaurant/shared-business-logic": "file:../../packages/shared-business-logic",
    "@restaurant/shared-types": "file:../../packages/shared-types",
    "@restaurant/shared-validation": "file:../../packages/shared-validation",
    "better-sqlite3": "^12.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "45.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wait-on": "^8.0.4",
    "tsx": "^4.20.0"
  },
  "build": {
    "appId": "com.sheikhaalkar.restaurantpos",
    "productName": "Sheikh Al Kar POS",
    "asar": true,
    "files": ["dist/**", "dist-electron/**", "database/**", "package.json"],
    "extraMetadata": { "main": "dist-electron/main.js" },
    "directories": { "output": "release" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    },
    "npmRebuild": true
  },
  "overrides": { "minimatch": "11.0.1" }
}
