{
  "name": "restaurant-cloud-apps",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/online-erp",
    "packages/*"
  ],
  "scripts": {
    "erp:dev": "npm run dev --prefix apps/online-erp",
    "erp:build": "npm run build --prefix apps/online-erp",
    "erp:start": "npm run start --prefix apps/online-erp",
    "desktop:dev": "npm run dev --prefix apps/desktop-pos",
    "desktop:build": "npm run build --prefix apps/desktop-pos",
    "package:windows": "npm run package:windows --prefix apps/desktop-pos",
    "db:generate": "npm run db:generate --prefix apps/online-erp",
    "db:migrate": "npm run db:migrate --prefix apps/online-erp",
    "db:deploy": "npm run db:deploy --prefix apps/online-erp",
    "install:cloud": "npm install --prefix apps/online-erp"
  }
}
